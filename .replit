modules = ["nodejs-20", "web", "postgresql-16", "python-base-3.13"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 4173
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "article-regressions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "article-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test && npm run test:articles:types"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check"

[workflows.workflow.metadata]
isValidation = true

[agent]
mockupState = "MOCKUP"

[postMerge]
path = "script/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
CONTACT_FROM_EMAIL = "onboarding@resend.dev"
CONTACT_TO_EMAIL = "ajkusharma@gmail.com"
